#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" != /* ]] && script_path="${script_dir}/${script_path}"
done

repo_dir="$(cd -P "$(dirname "$script_path")/.." && pwd)"
cd "$repo_dir"

if [[ $# -eq 0 ]]; then
  exec python3 step_05_import/oauth_import.py --count 1
fi

if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
  count="$1"
  shift
  exec python3 step_05_import/oauth_import.py --count "$count" "$@"
fi

exec python3 step_05_import/oauth_import.py "$@"
