#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" != /* ]] && script_path="${script_dir}/${script_path}"
done

repo_dir="$(cd -P "$(dirname "$script_path")/.." && pwd)"

# Local shortcut default: proxy registration Chrome traffic through Mihomo.
# HeroSMS / Cloud Mail / Sub2API calls remain direct; only the browser uses REGISTER_PROXY_URL.
export REGISTER_PROXY_URL="${REGISTER_PROXY_URL:-http://127.0.0.1:7892}"

exec bash "$repo_dir/bin/workers" reg 3 1
